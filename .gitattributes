# The build is verified on Windows as well as Unix, and the working copy here is
# checked out with core.autocrlf=true. Shell scripts are the case that breaks:
# a "#!/usr/bin/env bash" line ending in CRLF makes bash fail to find the
# interpreter -- the same `$'\r': command not found` failure that broke the opam
# build (see tools/build-deps.sh).
*.sh   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.ml   text eol=lf

# Read by Git itself. Without a rule of its own it falls under "* text=auto",
# so a checkout with core.autocrlf=true shows it as modified forever.
.gitattributes text eol=lf

# Everything else is source text; let Git normalise it on commit.
* text=auto

# Generated by tools/gen_providers.py from models.dev -- 54 providers, 478
# models, one line per field. Marked so that a data refresh, which touches
# nearly every line, is collapsed by default in a diff instead of burying the
# change that actually needs reviewing.
lib/ai_catalog.ml linguist-generated=true
